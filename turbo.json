{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "strict",
  "globalPassThroughEnv": ["TESTCONTAINERS_*", "DOCKER_HOST"],
  "globalDependencies": ["pnpm-workspace.yaml", ".node-version"],
  "remoteCache": { "enabled": false },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `*.tsbuildinfo` is deliberately NOT an output. It is build STATE, not
      // an artifact anything consumes, and it is the one file whose meaning
      // ("this project is up to date") depends on mtimes turbo does not
      // model. Caching it lets a restored cache hand back a "do not rebuild"
      // token keyed to a source hash it need not correspond to: `tsc -b`
      // decides by mtime, so a source file restored from a backup rewinds
      // time, the build is skipped, and the stale `dist` is then cached
      // against the NEW hash. That poisoned entry survives later runs and
      // turns `pnpm check` green over code nobody compiled — observed once
      // during Phase 2. Rebuilding all three packages from cold costs 2.6 s.
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_SITE_URL", "API_INTERNAL_URL"]
    },
    "dev": { "dependsOn": ["^build"], "persistent": true, "cache": false },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:integration": { "dependsOn": ["^build"], "cache": false },
    "boundaries": { "dependsOn": ["^build"] },
    "e2e": { "dependsOn": ["^build"], "cache": false },
    "api#build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "api#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/turbo.json"],
      "env": [
        "NODE_ENV",
        "PROCESS_ROLE",
        "PORT",
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "OUTBOX_POLL_MS",
        "OPENAPI_UI_ENABLED"
      ]
    },
    "api#test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "NODE_ENV",
        "PROCESS_ROLE",
        "PORT",
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "OUTBOX_POLL_MS",
        "OPENAPI_UI_ENABLED"
      ]
    },
    "api#openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi.json"],
      "env": [
        "NODE_ENV",
        "PROCESS_ROLE",
        "PORT",
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "OUTBOX_POLL_MS",
        "OPENAPI_UI_ENABLED"
      ]
    },
    "@ds/api-client#generate": {
      "dependsOn": ["api#openapi"],
      "outputs": ["src/generated/**"]
    }
  }
}
