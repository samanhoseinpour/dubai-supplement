{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "strict",
  "globalPassThroughEnv": ["TESTCONTAINERS_*", "DOCKER_HOST"],
  "globalDependencies": ["pnpm-workspace.yaml", ".node-version"],
  "remoteCache": { "enabled": false },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "*.tsbuildinfo"],
      "env": ["NEXT_PUBLIC_SITE_URL", "API_INTERNAL_URL"]
    },
    "dev": { "dependsOn": ["^build"], "persistent": true, "cache": false },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:integration": { "dependsOn": ["^build"], "cache": false },
    "boundaries": { "dependsOn": ["^build"] },
    "e2e": { "dependsOn": ["^build"], "cache": false },
    "api#build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "api#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/turbo.json"],
      "env": [
        "NODE_ENV",
        "PROCESS_ROLE",
        "PORT",
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "OUTBOX_POLL_MS",
        "OPENAPI_UI_ENABLED"
      ]
    },
    "api#test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "NODE_ENV",
        "PROCESS_ROLE",
        "PORT",
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "OUTBOX_POLL_MS",
        "OPENAPI_UI_ENABLED"
      ]
    },
    "api#openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi.json"],
      "env": [
        "NODE_ENV",
        "PROCESS_ROLE",
        "PORT",
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "OUTBOX_POLL_MS",
        "OPENAPI_UI_ENABLED"
      ]
    },
    "@ds/api-client#generate": {
      "dependsOn": ["api#openapi"],
      "outputs": ["src/generated/**"]
    }
  }
}
